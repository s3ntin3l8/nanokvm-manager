# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Server
PORT=8080

# NanoKVM credentials (shared default; per-host overrides go in the inventory config)
NANOKVM_USER=admin
NANOKVM_PASSWORD=

# Home Assistant (for power/wattage telemetry)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Grafana Loki (for per-host logs)
LOKI_URL=http://loki.local:3100
